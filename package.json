{
  "name": "yusha-steam-hour-bot",
  "private": true,
  "description": "yusha's Steam Hour Bot",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/server",
    "dev": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "demo": "npm run demo -w apps/server",
    "cli": "npm run cli -w apps/server --",
    "smoke": "npm run smoke -w apps/server",
    "build:web": "npm run build -w apps/web",
    "build:exe": "npm run build:web && npm run build:exe -w apps/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "deploy": "node --env-file-if-exists=.env deploy/deploy.mjs"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "steam-appticket": {
      "protobufjs": "^7.6.6"
    }
  },
  "version": "1.1.0"
}
