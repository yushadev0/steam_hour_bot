{
  "name": "yusha-steam-hour-bot",
  "private": true,
  "description": "yusha's Steam Hour Bot",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start -w apps/server",
    "cli": "npm run cli -w apps/server --",
    "smoke": "npm run smoke -w apps/server",
    "build:exe": "npm run build:exe -w apps/server",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "overrides": {
    "adm-zip": "^0.6.1",
    "steam-appticket": {
      "protobufjs": "^7.6.6"
    }
  }
}
